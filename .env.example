NEXT_API_URL=http://api:8080
NEXT_GS_URL=http://geoserver:8600
NEXT_PUBLIC_FILE_URL=http://localhost:8080/files/
FRONTEND_PORT=3000

# GeoServer REST admin — server-only, never sent to the browser. Used by
# /api/drone-acquisitions/[id]/publish to create/delete coverage stores for
# uploaded drone .tif files (see src/app/api/drone-acquisitions/[id]/publish/route.ts).
GS_ADMIN_USER=admin
GS_ADMIN_PASSWORD=
GS_WORKSPACE=land

# Газрын зургийн 3D турш: Cesium World Terrain (бодит өндөршил) ашиглахын тулд
# https://ion.cesium.com дээр үнэгүй (Community) бүртгэл үүсгэж, Access Token авна.
# Хоосон орхивол зөвхөн тэгш эллипсоид (өндөршилгүй) terrain ашиглана.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
